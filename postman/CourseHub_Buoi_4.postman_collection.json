    {
      "name": "02 - Get enrollment events - Co du lieu (Bai 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code la 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response la danh sach co du lieu\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "    pm.expect(data.length).to.be.at.least(1);",
              "});",
              "pm.test(\"Moi phan tu co day du cac truong can thiet\", () => {",
              "    const data = pm.response.json();",
              "    const item = data[0];",
              "    pm.expect(item).to.have.property(\"id\");",
              "    pm.expect(item).to.have.property(\"student_id\");",
              "    pm.expect(item).to.have.property(\"class_section_id\");",
              "    pm.expect(item).to.have.property(\"event_type\");",
              "    pm.expect(item).to.have.property(\"occurred_at\");",
              "});",
              "pm.test(\"Ket qua da duoc loc theo dung student_id\", () => {",
              "    const data = pm.response.json();",
              "    data.forEach(item => {",
              "        pm.expect(item.student_id).to.eql(\"22000001\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/enrollment-events?student_id=22000001&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "enrollment-events"
          ],
          "query": [
            {
              "key": "student_id",
              "value": "22000001",
              "description": "Loc theo ma sinh vien co du lieu"
            },
            {
              "key": "limit",
              "value": "10",
              "description": "Gioi han 1-100"
            }
          ]
        }
      },
      "response": []
    },
