    {
      "name": "06 - Demo rollback - Loi Check constraint va Rollback (Bai 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code la 409 Conflict\", () => {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test(\"Thong bao rollback thanh cong\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data.detail).to.include(\"rollback\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
